[Unit]
Description=Keep the Proton Pass session and SSH agent alive (PAT re-login + key reload)

[Service]
Type=oneshot
Environment=PROTON_PASS_LINUX_KEYRING=dbus
Environment=SSH_AUTH_SOCK=%h/.ssh/proton-pass-agent.sock
ExecStart=%h/.config/omarchy/plugins/ziouf.proton-pass/scripts/pass-ssh-agent-health
