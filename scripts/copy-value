#!/bin/bash
# copy-value — put an already-decrypted value on the clipboard.
# usage: copy-value <buffer-file> <label> [kind] [clear-after-seconds]
#
# Byte-exact: the file is piped straight into wl-copy, so multiline values and
# special characters survive untouched. The buffer lives in XDG_RUNTIME_DIR
# (tmpfs, 0600), is shredded right after the copy, and the clipboard is
# cleared after the optional delay if our value is still what sits there
# (SHA-256 comparison). Notification wording follows LC_ALL / LC_MESSAGES /
# LANG (fr, zh, else en).

set -euo pipefail

file="${1:?usage: copy-value <buffer-file> <label> [kind] [clear-after-seconds]}"
label="${2:?}"
kind="${3:-value}"
clear_after="${4:-30}"

# --- i18n -----------------------------------------------------------------
raw_lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
lang="$(echo "${raw_lang%%.*}" | cut -d_ -f1 | tr '[:upper:]' '[:lower:]')"
case "$lang" in fr|zh) ;; *) lang="en" ;; esac

if [[ "$lang" == "fr" ]]; then
  msg_copied="Copié"
  kind_secret="secret"
  kind_value="valeur"
  msg_of_item='%1 « %2 » (%3 s)'
elif [[ "$lang" == "zh" ]]; then
  msg_copied="已复制"
  kind_secret="机密"
  kind_value="值"
  msg_of_item='%2 的 %1（%3 秒）'
else
  msg_copied="Copied"
  kind_secret="secret"
  kind_value="value"
  msg_of_item='%1 "%2" (%3 s)'
fi

case "$kind" in
  secret|password) display_kind="$kind_secret" ;;
  *)               display_kind="$kind_value" ;;
esac

fmt() { # fmt <template> <arg1> [arg2] [arg3]
  local out="$1"; shift
  local i=1
  while (( $# > 0 )); do
    out="${out//%$i/$1}"
    shift; ((i++))
  done
  printf '%s' "$out"
}

command -v wl-copy >/dev/null 2>&1 || exit 1
[[ -f $file ]] || exit 1

# Byte-exact copy: pipe the file, never an expanded variable.
expected_sum="$(sha256sum < "$file" | cut -d' ' -f1)"
wl-copy --sensitive < "$file" >/dev/null 2>&1
shred -u "$file" 2>/dev/null || rm -f "$file"

if [[ "$clear_after" =~ ^[0-9]+$ ]] && (( clear_after > 0 )); then
  (
    sleep "$clear_after"
    current_sum="$(wl-paste 2>/dev/null | sha256sum | cut -d' ' -f1 || true)"
    [[ "$current_sum" == "$expected_sum" ]] && wl-copy --clear || true
  ) &
  disown
fi

notify-send -a "Proton Pass" -t 2000 "$msg_copied" \
  "$(fmt "$msg_of_item" "$display_kind" "$label" "$clear_after")" 2>/dev/null || true
