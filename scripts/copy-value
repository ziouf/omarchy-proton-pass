#!/bin/bash
# copy-value — put an already-decrypted value on the clipboard.
# usage: copy-value <buffer-file> <label> [kind] [clear-after-seconds]
#
# The value is read from a 0600 file in XDG_RUNTIME_DIR (tmpfs), never passed
# as a process argument. The buffer file is removed immediately after the
# copy, and the clipboard is cleared after the optional delay if our value is
# still what sits there. Notification wording follows LC_ALL / LC_MESSAGES /
# LANG (fr, else en).

set -euo pipefail

file="${1:?usage: copy-value <buffer-file> <label> [kind] [clear-after-seconds]}"
label="${2:?}"
kind="${3:-value}"
clear_after="${4:-30}"

# --- i18n -----------------------------------------------------------------
raw_lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
lang="$(echo "${raw_lang%%.*}" | cut -d_ -f1 | tr '[:upper:]' '[:lower:]')"
[[ "$lang" == "fr" ]] || lang="en"

if [[ "$lang" == "fr" ]]; then
  msg_copied="Copié"
  kind_secret="secret"
  kind_value="valeur"
  msg_of_item='%1 « %2 » (%3 s)'
else
  msg_copied="Copied"
  kind_secret="secret"
  kind_value="value"
  msg_of_item='%1 "%2" (%3 s)'
fi

case "$kind" in
  secret|password) display_kind="$kind_secret" ;;
  *)               display_kind="$kind_value" ;;
esac

fmt() { # fmt <template> <arg1> [arg2] [arg3]
  local out="$1"; shift
  local i=1
  while (( $# > 0 )); do
    out="${out//%$i/$1}"
    shift; ((i++))
  done
  printf '%s' "$out"
}

command -v wl-copy >/dev/null 2>&1 || exit 1
[[ -f $file ]] || exit 1

secret="$(cat "$file")"
shred -u "$file" 2>/dev/null || rm -f "$file"

printf '%s' "$secret" | wl-copy

if [[ "$clear_after" =~ ^[0-9]+$ ]] && (( clear_after > 0 )); then
  (
    sleep "$clear_after"
    current="$(wl-paste 2>/dev/null || true)"
    [[ "$current" == "$secret" ]] && wl-copy --clear || true
  ) &
  disown
fi

notify-send -a "Proton Pass" -t 2000 "$msg_copied" \
  "$(fmt "$msg_of_item" "$display_kind" "${label}" "${clear_after}")" 2>/dev/null || true
