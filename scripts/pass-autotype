#!/bin/bash
# pass-autotype — type an item's username, then Tab, then its password into
# the currently focused window (KeePassXC-style), using wtype.
#
# usage: pass-autotype <vault-or-share-id> <item-id-or-title>
#
# Safety: a 3-second heads-up notification lets you cancel by switching focus
# or closing; no Enter is ever typed. Secrets travel via stdin (never process
# arguments, so they stay out of /proc/*/cmdline) and live in 0600 tmpfs
# buffers that are shredded immediately. Set PASS_GENERIC_NOTIFY=1 to keep
# item titles out of notifications.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/i18n.sh"

# Keep the encryption key in the Secret Service so sessions survive reboots;
# the kernel keyring default is wiped at every boot. Respect an explicit override.
export PROTON_PASS_LINUX_KEYRING="${PROTON_PASS_LINUX_KEYRING:-dbus}"

share="${1:?usage: pass-autotype <vault> <item>}"
item="${2:?usage: pass-autotype <vault> <item>}"

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"

fetch() { # fetch <field> <buffer> — $() strips the CLI formatting newline;
          # trailing newlines are deliberately never typed (they would press
          # Enter in the target window).
  local secret
  secret="$(pass-cli item view "pass://$share/$item/$1")" || return 1
  printf '%s' "$secret" > "$2"
}

command -v wtype >/dev/null 2>&1 || {
  notify-send -a "Proton Pass" -u critical "$msg_wtype_missing_title" 2>/dev/null || true
  exit 1
}

user_buf="$(mktemp "$runtime_dir/ziouf.proton-pass.XXXXXX")"
pass_buf="$(mktemp "$runtime_dir/ziouf.proton-pass.XXXXXX")"
trap 'shred -u "$user_buf" "$pass_buf" 2>/dev/null || rm -f "$user_buf" "$pass_buf"' EXIT
chmod 600 "$user_buf" "$pass_buf"

if ! fetch username "$user_buf"; then printf '' > "$user_buf"; fi
fetch password "$pass_buf" || {
  notify-send -a "Proton Pass" -u critical "$(fmt "$msg_read_failed_autotype_body" "$item")" 2>/dev/null || true
  exit 1
}

username="$(cat "$user_buf")"

notify-send -a "Proton Pass" -t 3000 "$msg_autotype_soon_body" 2>/dev/null || true
sleep 3

if [[ -n "$username" ]]; then
  wtype - < "$user_buf"
  sleep 0.15
  wtype -k Tab
  sleep 0.15
fi
wtype - < "$pass_buf"

if [[ "$generic" == "1" ]]; then
  notify-send -a "Proton Pass" -t 2000 "$msg_autotype_done_body_generic" 2>/dev/null || true
else
  notify-send -a "Proton Pass" -t 2000 "$(fmt "$msg_autotype_done_body" "$item")" 2>/dev/null || true
fi
