#!/bin/bash
# copy-secret — fetch a field from Proton Pass and put it on the clipboard.
# usage: copy-secret <vault-or-share-id> <item-id-or-title> <field> [clear-after-seconds]
#
# The field is fetched with a pass:// secret reference into a 0600 tmpfs
# buffer, then handed to copy-value for a byte-exact copy with auto-clear.
# Exit codes: 0 ok, 1 generic failure, 3 field absent (e.g. no TOTP).
# Notification wording follows LC_ALL / LC_MESSAGES / LANG (fr, zh, else en).

set -euo pipefail

vault="${1:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
item="${2:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
field="${3:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
clear_after="${4:-30}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- i18n -----------------------------------------------------------------
raw_lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
lang="$(echo "${raw_lang%%.*}" | cut -d_ -f1 | tr '[:upper:]' '[:lower:]')"
case "$lang" in fr|zh) ;; *) lang="en" ;; esac

if [[ "$lang" == "fr" ]]; then
  msg_missing_cli_title="pass-cli introuvable"
  msg_install_hint="Installez proton-pass-cli."
  msg_missing_wlcopy_title="wl-copy manquant"
  msg_wlcopy_needed="wl-clipboard est requis pour copier."
  msg_read_failed="Échec de lecture"
  msg_read_body='%1 pour « %2 »'
  msg_no_totp="Pas de code TOTP"
  msg_no_totp_body="Aucun code TOTP configuré pour « %1 »."
  lbl_totp="code TOTP"
  lbl_password="mot de passe"
  lbl_username="identifiant"
elif [[ "$lang" == "zh" ]]; then
  msg_missing_cli_title="未找到 pass-cli"
  msg_install_hint="请安装 proton-pass-cli。"
  msg_missing_wlcopy_title="缺少 wl-copy"
  msg_wlcopy_needed="需要 wl-clipboard 才能复制。"
  msg_read_failed="读取失败"
  msg_read_body='“%2”的 %1'
  msg_no_totp="没有 TOTP 验证码"
  msg_no_totp_body="“%1”未配置 TOTP 验证码。"
  lbl_totp="TOTP 验证码"
  lbl_password="密码"
  lbl_username="用户名"
else
  msg_missing_cli_title="pass-cli not found"
  msg_install_hint="Install proton-pass-cli."
  msg_missing_wlcopy_title="wl-copy missing"
  msg_wlcopy_needed="wl-clipboard is required to copy."
  msg_read_failed="Failed to read"
  msg_read_body='%1 for "%2"'
  msg_no_totp="No TOTP code"
  msg_no_totp_body="No TOTP configured for \"%1\"."
  lbl_totp="TOTP code"
  lbl_password="password"
  lbl_username="username"
fi

fmt() { # fmt <template> <arg1> [arg2] [arg3]
  local out="$1"; shift
  local i=1
  while (( $# > 0 )); do
    out="${out//%$i/$1}"
    shift; ((i++))
  done
  printf '%s' "$out"
}

command -v pass-cli >/dev/null 2>&1 || {
  notify-send -a "Proton Pass" -u critical "$msg_missing_cli_title" "$msg_install_hint" 2>/dev/null || true
  exit 1
}
command -v wl-copy >/dev/null 2>&1 || {
  notify-send -a "Proton Pass" -u critical "$msg_missing_wlcopy_title" "$msg_wlcopy_needed" 2>/dev/null || true
  exit 1
}

case "$field" in
  totp) label="$lbl_totp" ;;
  password) label="$lbl_password" ;;
  username) label="$lbl_username" ;;
  *) label="$field" ;;
esac

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
buffer="$(mktemp "$runtime_dir/ziouf.proton-pass.XXXXXX")"
chmod 600 "$buffer"
err_file="$(mktemp "$runtime_dir/ziouf.proton-pass.err.XXXXXX")"
trap 'rm -f "$err_file"' EXIT

# CLI output formatting newline is stripped; interior newlines survive.
secret="$(pass-cli item view "pass://$vault/$item/$field" 2>"$err_file")" || {
  if grep -qiE "field does not exist|no totp" "$err_file"; then
    rm -f "$buffer"
    notify-send -a "Proton Pass" -t 3000 "$msg_no_totp" \
      "$(fmt "$msg_no_totp_body" "$item")" 2>/dev/null || true
    exit 3
  fi
  rm -f "$buffer"
  notify-send -a "Proton Pass" -u critical "$msg_read_failed" \
    "$(fmt "$msg_read_body" "$label" "$item")" 2>/dev/null || true
  exit 1
}
printf '%s' "$secret" > "$buffer"

exec "$SCRIPT_DIR/copy-value" "$buffer" "$label" "$field" "$clear_after"
