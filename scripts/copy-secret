#!/bin/bash
# copy-secret — fetch a field from Proton Pass and put it on the clipboard.
# usage: copy-secret <vault-or-share-id> <item-id-or-title> <field> [clear-after-seconds]
#
# The field is fetched with a pass:// secret reference, piped to wl-copy, and
# cleared after an optional delay so secrets do not linger in the clipboard.

set -euo pipefail

vault="${1:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
item="${2:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
field="${3:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
clear_after="${4:-30}"

command -v pass-cli >/dev/null 2>&1 || {
  notify-send -a "Proton Pass" -u critical "pass-cli introuvable" "Installez proton-pass-cli." 2>/dev/null || true
  exit 1
}
command -v wl-copy >/dev/null 2>&1 || {
  notify-send -a "Proton Pass" -u critical "wl-copy manquant" "wl-clipboard est requis pour copier." 2>/dev/null || true
  exit 1
}

secret="$(pass-cli item view "pass://$vault/$item/$field")" || {
  notify-send -a "Proton Pass" -u critical "Échec de lecture" "$field pour « $item »" 2>/dev/null || true
  exit 1
}

printf '%s' "$secret" | wl-copy

if [[ "$clear_after" =~ ^[0-9]+$ ]] && (( clear_after > 0 )); then
  (
    sleep "$clear_after"
    # Only clear if our value is still what sits on the clipboard.
    current="$(wl-paste 2>/dev/null || true)"
    [[ "$current" == "$secret" ]] && wl-copy --clear || true
  ) &
  disown
fi

label="$field"
case "$field" in
  totp) label="code TOTP" ;;
  password) label="mot de passe" ;;
  username) label="identifiant" ;;
esac
notify-send -a "Proton Pass" -t 2000 "Copié" "$label de « $item » (${clear_after:-∞} s)" 2>/dev/null || true
