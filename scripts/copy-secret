#!/bin/bash
# copy-secret — fetch a field from Proton Pass and put it on the clipboard.
# usage: copy-secret <vault-or-share-id> <item-id-or-title> <field> [clear-after-seconds]
#
# The field is fetched with a pass:// secret reference straight into a 0600
# tmpfs buffer (byte-exact: only the CLI's trailing formatting newline is
# stripped), then handed to copy-value for the copy with auto-clear.
# Exit codes: 0 ok, 1 generic failure, 3 field absent (e.g. no TOTP).
# Notification wording follows LC_ALL / LC_MESSAGES / LANG (fr, zh, else en).
# Set PASS_GENERIC_NOTIFY=1 to keep item titles out of notifications.

set -euo pipefail

# Keep the encryption key in the Secret Service so sessions survive reboots;
# the kernel keyring default is wiped at every boot. Respect an explicit override.
export PROTON_PASS_LINUX_KEYRING="${PROTON_PASS_LINUX_KEYRING:-dbus}"

vault="${1:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
item="${2:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
field="${3:?usage: copy-secret <vault> <item> <field> [clear-after-seconds]}"
clear_after="${4:-30}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/i18n.sh"


command -v pass-cli >/dev/null 2>&1 || {
  notify-send -a "Proton Pass" -u critical "$msg_missing_cli_title" "$msg_install_hint" 2>/dev/null || true
  exit 1
}
command -v wl-copy >/dev/null 2>&1 || {
  notify-send -a "Proton Pass" -u critical "$msg_missing_wlcopy_title" "$msg_wlcopy_needed" 2>/dev/null || true
  exit 1
}

case "$field" in
  totp) label="$lbl_totp" ;;
  password) label="$lbl_password" ;;
  username) label="$lbl_username" ;;
  *) label="$field" ;;
esac

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
buffer="$(mktemp "$runtime_dir/ziouf.proton-pass.XXXXXX")"
chmod 600 "$buffer"
err_file="$(mktemp "$runtime_dir/ziouf.proton-pass.err.XXXXXX")"

# Byte-exact fetch: the raw stream goes to the buffer; exactly one trailing
# newline (the CLI's formatting) is removed, everything else is preserved.
if ! pass-cli item view "pass://$vault/$item/$field" > "$buffer" 2> "$err_file"; then
  if grep -qiE "field does not exist|no totp" "$err_file"; then
    rm -f "$buffer" "$err_file"
    if [[ "$generic" == "1" ]]; then
      notify-send -a "Proton Pass" -t 3000 "$msg_no_totp" "$msg_no_totp_body_generic" 2>/dev/null || true
    else
      notify-send -a "Proton Pass" -t 3000 "$msg_no_totp" \
        "$(fmt "$msg_no_totp_body" "$item")" 2>/dev/null || true
    fi
    exit 3
  fi
  rm -f "$buffer"
  if [[ "$generic" == "1" ]]; then
    notify-send -a "Proton Pass" -u critical "$msg_read_failed" \
      "$(fmt "$msg_read_body_generic" "$label")" 2>/dev/null || true
  else
    notify-send -a "Proton Pass" -u critical "$msg_read_failed" \
      "$(fmt "$msg_read_body" "$label" "$item")" 2>/dev/null || true
  fi
  exit 1
fi

# Strip exactly one trailing LF (CLI formatting), preserving the rest.
if [[ -s "$buffer" ]] && [[ "$(tail -c 1 "$buffer" | wc -l)" -eq 1 ]]; then
  truncate -s -1 "$buffer"
fi
rm -f "$err_file"

exec "$SCRIPT_DIR/copy-value" "$buffer" "$label" "$field" "$clear_after"
